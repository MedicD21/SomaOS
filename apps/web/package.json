{
  "name": "@soma/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint src e2e tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"tests/db/**\"",
    "test:db": "vitest run tests/db",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@soma/auth": "workspace:*",
    "@soma/config-core": "workspace:*",
    "@soma/custom-fields": "workspace:*",
    "@soma/schedule-engine": "workspace:*",
    "@soma/validators": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@soma/db": "workspace:*",
    "@soma/templates": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "otplib": "^13.6.0",
    "tailwindcss": "^4.3.5"
  }
}
