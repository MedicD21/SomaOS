{
  "name": "@soma/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env.local src/index.ts",
    "run-once": "tsx --env-file-if-exists=.env.local src/index.ts --once",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db --no-file-parallelism"
  },
  "dependencies": {
    "@soma/schedule-engine": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15"
  }
}
